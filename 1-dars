        int a1 = 10;
        Console.WriteLine(a1 % 2 == 0);

        // 2. Toq
        int a2 = 7;
        Console.WriteLine(a2 % 2 != 0);

        // 3. 2 xonali
        int a3 = 45;
        Console.WriteLine(a3 >= 10 && a3 <= 99);

        // 4. 4 xonali
        int a4 = 2345;
        Console.WriteLine(a4 >= 1000 && a4 <= 9999);

        // 5. Juft va 2 xonali
        int a5 = 28;
        Console.WriteLine(a5 % 2 == 0 && a5 >= 10 && a5 <= 99);

        // 6. Toq va 3 xonali
        int a6 = 357;
        Console.WriteLine(a6 % 2 != 0 && a6 >= 100 && a6 <= 999);

        // 7. Juft va 4 xonali
        int a7 = 2468;
        Console.WriteLine(a7 % 2 == 0 && a7 >= 1000 && a7 <= 9999);

        // 8. 2 tasi ham toq
        int a8 = 7, b8 = 13;
        Console.WriteLine(a8 % 2 != 0 && b8 % 2 != 0);

        // 9. 2 tasi ham juft
        int a9 = 12, b9 = 44;
        Console.WriteLine(a9 % 2 == 0 && b9 % 2 == 0);

        // 10. 2 xonali va toq
        int a10 = 35, b10 = 79;
        Console.WriteLine(a10 >= 10 && a10 <= 99 &&
                          b10 >= 10 && b10 <= 99 &&
                          a10 % 2 != 0 && b10 % 2 != 0);

        // 11. Raqamlari teng
        int a11 = 33;
        Console.WriteLine((a11 / 10) == (a11 % 10));

        // 12. Yig‘indi 10 dan katta
        int a12 = 68;
        Console.WriteLine((a12 / 10 + a12 % 10) > 10);

        // 13. Ko‘paytma 20 dan katta
        int a13 = 58;
        Console.WriteLine((a13 / 10 * (a13 % 10)) > 20);

        // 14. 2 raqami toq
        int a14 = 75;
        Console.WriteLine((a14 / 10) % 2 != 0 && (a14 % 10) % 2 != 0);

        // 15. 2 raqami 5 dan katta
        int a15 = 89;
        Console.WriteLine((a15 / 10) > 5 && (a15 % 10) > 5);

        // 16. 3 ga karrali
        int a16 = 27;
        Console.WriteLine(a16 % 3 == 0);

        // 17. 7 ga karrali
        int a17 = 49;
        Console.WriteLine(a17 % 7 == 0);

        // 18. 3 va 8 ga karrali
        int a18 = 24;
        Console.WriteLine(a18 % 3 == 0 && a18 % 8 == 0);

        // 19. 7 yoki 9 ga karrali
        int a19 = 63;
        Console.WriteLine(a19 % 7 == 0 || a19 % 9 == 0);

        // 20. 3 ga karrali
        int a20 = 12;
        Console.WriteLine(a20 % 3 == 0);

        // 21. 5 ga bo‘linmaydi
        int a21 = 17;
        Console.WriteLine(a21 % 5 != 0);

        // 22. 4 ga bo‘linib 3 ga bo‘linmaydi
        int a22 = 20;
        Console.WriteLine(a22 % 4 == 0 && a22 % 3 != 0);

        // 23. a > b
        int a23 = 15, b23 = 10;
        Console.WriteLine(a23 > b23);

        // 24. a == b
        int a24 = 20, b24 = 20;
        Console.WriteLine(a24 == b24);

